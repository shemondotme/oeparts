# ══════════════════════════════════════════════════════════════════════════════
# OeParts — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
# This file is for environment-level concerns only: credentials, drivers, and a
# handful of security keys that must exist before certain features can safely
# run. Everything else — VAT rates, OTP on/off, rate limits, search thresholds —
# lives in the `settings` database table, editable from the admin panel. Never
# hardcode business config here; it would need a redeploy to change.
#
# Quick start: `cp .env.example .env && php artisan key:generate`, or simply
# visit /install — the web installer writes DB, mail, and site values into this
# file for you, and auto-generates APP_KEY on its very first request if one
# doesn't exist yet. See README.md → Configuration for the full picture, and
# SECURITY.md → "Hardening notes for self-hosters" for the security-sensitive
# keys further down this file.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────────
APP_NAME=OeParts
# "production" ships safe defaults out of the box: no debug output, and no
# forced HTTPS scheme unless APP_URL below is itself an https:// URL. Only use
# "local" on a machine nobody outside your own network can reach.
APP_ENV=production
# Generate with `php artisan key:generate` — required before the app can
# encrypt sessions and cookies. Leave blank for a fresh clone: the web
# installer (and this app's own entrypoint) generates a random one on the
# first request if this is empty.
APP_KEY=
# Never expose stack traces to visitors — keep this false outside local dev.
APP_DEBUG=false
# Full base URL including scheme (http:// or https://). Leave the scheme as
# http:// until SSL is actually provisioned on this domain: session-cookie
# security and the app's forced-HTTPS behavior both key off this value, and
# setting https:// here before your host actually serves HTTPS will break the
# app over plain HTTP (mixed-content asset failures, cookies the browser
# refuses to store).
APP_URL=http://localhost

# ─── Localization ───────────────────────────────────────────────────────────────
# Storefront ships 5 languages (en/de/lt/fr/es) with auto-detect from the
# browser — these three only affect artisan/queue/test contexts that have no
# request to detect a language from.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ─── Runtime ─────────────────────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Leave blank unless nginx/Apache sits in FRONT of PHP-FPM as a reverse proxy,
# or this app is behind a CDN/load balancer that terminates TLS. When blank
# (default), the app trusts nothing but the direct TCP connection — correct
# and safest for the common case where the web server itself talks to PHP.
# When set, the app trusts X-Forwarded-* headers from the listed upstream(s),
# so $request->ip() (IpBlocklist, rate limiting) sees the real client instead
# of the proxy, and generated https:// URLs / secure-cookie flags are correct
# behind TLS-terminating infrastructure. Comma-separated IPs/CIDRs, or `*` to
# trust any upstream (only safe if nothing but your own proxy can reach this
# app server directly — see deploy/nginx/oeparts.conf's HTTPS section).
TRUSTED_PROXIES=

# ─── Logging ─────────────────────────────────────────────────────────────────────
# 'daily' rotates storage/logs/laravel.log and auto-prunes files older than
# LOG_DAILY_DAYS (default 14) — 'single' never rotates or prunes and will
# grow unbounded on a real deployment.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oeparts
DB_USERNAME=root
DB_PASSWORD=

# ─── Cache / Sessions / Queues ─────────────────────────────────────────────────
# Defaults to file/sync so a fresh install works with zero extra setup — no
# Redis extension or server required (shared hosting reality). If Redis is
# available, switch all three to `redis` for better performance under load;
# see the Redis block below for connection settings.
#
# CACHE_STORE can also be `memcached` (see the Memcached block below) if your
# host has that instead of Redis — but Memcached is cache-only: Laravel has no
# memcached SESSION_DRIVER or QUEUE_CONNECTION, so those two stay file/sync
# (or database/redis) regardless of what you pick for the cache.
CACHE_STORE=file
CACHE_PREFIX=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync

# ─── Redis ─────────────────────────────────────────────────────────────────────
# REDIS_CLIENT=phpredis needs the `redis` PHP extension. No extension on your
# host? Set REDIS_CLIENT=predis instead — a pure-PHP client (bundled via
# composer, predis/predis) that talks to the same Redis server with zero
# native extension required.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Memcached (only used if CACHE_STORE=memcached above) ─────────────────────
# Requires the `memcached` PHP extension. Defaults below match a typical
# local install; uncomment and adjust for a remote/managed Memcached server.
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=

# ─── Mail ──────────────────────────────────────────────────────────────────────
# All emails are queued, never sent inline. MAIL_MAILER accepts smtp,
# sendmail, or log (writes to storage/logs/laravel.log instead of sending —
# handy for a first test install with no SMTP yet). Normally set via the web
# installer's Email Setup step; edit below only if configuring by hand.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ─── Airwallex Payments ────────────────────────────────────────────────────────
# NOT configured here on purpose. Airwallex credentials (Client ID, API Key,
# Webhook Secret, Environment) are entered in the Admin Panel under
# Settings → Payment Settings and stored in the database (payment.airwallex_*
# keys) — never in .env. Card/bank-transfer checkout stays disabled until you
# set them there; the store runs fine without online payments configured.

# ─── AWS (optional — for file storage) ────────────────────────────────────────
# Only needed if FILESYSTEM_DISK below (or a backup disk) is set to `s3`.
# Off-site backup disks must be an EU region for GDPR — see README.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Broadcasting ──────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ─── Update & Recovery System (Module 21) ─────────────────────────────────────
OE_UPDATE_ENABLED=true
OE_UPDATE_CHANNEL=stable
OE_UPDATE_AUTO_SECURITY=false
# OE_UPDATE_CHECK_URL=
# OE_UPDATE_CATALOG_URL=

# Backups — encryption is MANDATORY (backups hold customer PII / GDPR).
# Auto-generated by the web installer on a fresh install (see InstallManager's
# backup_key step) — you normally never touch this by hand. Setting up without
# the installer? Generate a strong random key and BACK IT UP: losing it makes
# every encrypted backup unrecoverable. Use a dedicated key, NOT APP_KEY.
# e.g. `openssl rand -base64 32`
OE_BACKUP_KEY=
OE_BACKUP_DISK=local
# OE_BACKUP_SCHEDULE=true

# Recovery console (public/oe-recovery.php) — disabled unless a key is set.
OE_RECOVERY_KEY=
# OE_RECOVERY_IP_ALLOWLIST=203.0.113.4,198.51.100.7
# Recovery console hardening (optional — sensible defaults shown):
# OE_RECOVERY_MAX_ATTEMPTS=5         # failed key/token attempts before lockout
# OE_RECOVERY_LOCKOUT_SECONDS=900    # lockout + failure-count window (seconds)
# OE_RECOVERY_TOKEN_TTL=900          # confirm-token lifetime (seconds)

# Release signature verification (RSA-SHA256). When a public key is set, updates are
# authenticated (not just checksummed) and an unsigned/tampered release is BLOCKED at
# pre-flight. Public key is app-baked (ships with each release, or committed to
# resources/keys/release-public.pem). PRIVATE key is a build/CI secret — NEVER commit it.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out release-private.pem
#   openssl rsa -in release-private.pem -pubout -out release-public.pem
# OE_RELEASE_PUBLIC_KEY=            # PEM (or commit resources/keys/release-public.pem)
# OE_RELEASE_PRIVATE_KEY=          # PEM — CI secret only, on the release runner

# ─── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Instance mode: what this installation IS. Leave everything here as it is on a
# normal site. A site moved in from another one (an import) is set up for you.
#
#   OE_MODE=production   the real shop (default when empty or missing)
#   OE_MODE=staging      a testing copy: no mail, no real payments, hidden from search engines
#   OE_MODE=quarantine   a just-moved copy that is not trusted yet: even stricter
#
# A value that is not one of these three is treated as quarantine (a typo can
# never turn a copy back into the real shop) and is logged as critical.
# OE_INSTANCE_ID=
# OE_MAIL_ALLOWLIST=you@example.com,@yourcompany.com   # staging may still mail these
# OE_NONPROD_HTTP_CRON=false                           # run the web cron fallback on a copy
# ----------------------------------------------------------------------------
# OE_MODE=

# ─── Site migration (.oeparts) ─────────────────────────────────────────────────
# Moving a whole shop to another server with one encrypted file: README → "Site
# Migration (.oeparts)". Nothing here is needed to export or import a site; every
# key is optional and shown with its default, so leave them commented unless you
# have a reason. (The worker line `--queue=migration,critical,default,low` and the
# cron line are covered in the README; they are not .env settings.)
#
# The web installer's "Import an existing site" branch. Environment-only on
# purpose: both weaken a protection, so neither is ever a form field.
#   true  = the installer may take a package passphrase over plain http, where
#           anyone on the way can read it. Prefer https or the command line.
# OE_INSTALLER_ALLOW_HTTP_PASSPHRASE=false
#   false = the installer does not list storage/app/import/ and asks for the
#           file name instead (a host where the file names themselves are private).
# OE_INSTALLER_LIST_INBOX=true
#
# One-time download links (/_pkg/{token}) made by `oeparts:migrate:share`.
# Downloads of a link at the same time. PHP cannot see how many workers your web
# server has, so 1 is the safe default; a second request gets 503 + Retry-After.
# Raise it only when your PHP-FPM pool has 8 or more workers.
# OE_SHARE_MAX_STREAMS=1
#
# Fetching a package from a link (`oeparts:migrate:fetch`, `oeparts:migrate:import --url`).
# https only. The protection against reaching internal addresses is NOT a setting
# and cannot be switched off in the admin panel.
# OE_MIGRATION_ALLOWED_HOSTS=            # comma separated; only these hosts and their subdomains
# OE_MIGRATION_ALLOWED_PORTS=443         # comma separated list of the ports a download may use
# OE_MIGRATION_ALLOW_PRIVATE_HOSTS=false # true = both sites are on private addresses (an intranet, a rehearsal): turns the private-address check OFF
# OE_MIGRATION_FETCH_MAX_BYTES=34359738368   # the largest package a link may bring (32 GiB)
#
# Export
# OE_MIGRATION_EXPORT_RETENTION_DAYS=7   # days an exported package stays on this site (it is a full copy of your customers' data)
# OE_MIGRATION_FREEZE_MAX_MINUTES=180    # a freeze export keeps the shop in maintenance at most this long
# OE_MIGRATION_HOLD_AUTO_RELEASE_MINUTES=120   # a finished freeze export holds the shop this long for you; 0 = until `oeparts:migrate:unfreeze`
# OE_MIGRATION_FREEZE_REFUSE_MINUTES=720 # a freeze is refused when even the estimate says the shop would be closed longer than this
# OE_MIGRATION_EXPORT_HEARTBEAT=1800     # seconds without progress after which an export counts as dead
#
# Import
# OE_MIGRATION_RECOVERY_MAX_ROWS=500000  # the largest site (rows outside the System group) the built-in recovery point can hold
# OE_MIGRATION_FULLTEXT_STRATEGY=drop_readd   # drop_readd = drop the products search index before the load and rebuild it after (MySQL); keep = leave it (more than twice as slow)
# OE_MIGRATION_IMPORT_HEARTBEAT=1800     # seconds without progress after which an import counts as stalled
# OE_MIGRATION_LONG_STAGE_SECONDS=7200   # how long one step that cannot be split (rebuilding the search index) may take before it looks stalled
# OE_MIGRATION_QUEUE_HOLD_SECONDS=86400  # the longest a client is told the queue stays held while a site is replaced
# OE_MIGRATION_SITEMAP_INLINE_MAX=50000  # up to this many products the sitemap is built while the import finishes; above it the nightly schedule does it
# OE_MIGRATION_REBUILD_CACHE=true        # clear and rebuild the framework caches after an import
# OE_MIGRATION_ESCROW_TTL=86400          # seconds the keys of a run (derived from the passphrase, never the passphrase) may stay on disk at most
#
# Logs: storage/logs/migration.log (what was exported, imported, rolled back, by whom)
# and storage/logs/instance-mail.log (mail a staging/quarantine copy suppressed:
# recipient, subject and class, never the body).
# OE_MIGRATION_LOG_DAYS=60
# OE_INSTANCE_MAIL_LOG_DAYS=14
#
# Launch checks (`oeparts:instance:readiness`, System → Site mode): an address that
# reaches THIS server, for example http://127.0.0.1, so the page checks go through
# the real web server with this site's own Host header. Empty = ask inside the
# application only (the report then says it is partial).
# OE_READINESS_LOOPBACK=
